# Copy this file to ".env" and fill in your values.

# PostgreSQL (replace YOUR_PASSWORD). If you remove this line, the app uses a local SQLite file instead.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/smartbuy

# Any long random string. Used to sign login tokens.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-characters

# Frontend address(es) allowed to call the API, comma separated
CORS_ORIGINS=http://localhost:5173

# Optional: enables the LLM-powered assistant. Leave empty to use the built-in rule-based parser.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Map services for ride comparison (free OpenStreetMap servers by default)
# PHOTON_URL=https://photon.komoot.io
# OSRM_URL=https://router.project-osrm.org
# GEO_OFFLINE=true   # use the built-in sample places only (no internet needed)
